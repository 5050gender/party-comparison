<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <style>
        /* Heebo embedded locally as data: URIs -- no network/CDN dependency
           at render time (matches the arc chart's font). */
        @font-face {
            font-family: 'Heebo';
            src: url('{{ heebo_regular_data_uri }}') format('truetype');
            font-weight: 400;
        }
        @font-face {
            font-family: 'Heebo';
            src: url('{{ heebo_bold_data_uri }}') format('truetype');
            font-weight: 700;
        }
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }
        body {
            font-family: 'Heebo', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #ffffff;
            color: #000000;
            display: flex;
            justify-content: center;
            padding: 20px 15px 30px;
        }

        .chart-wrapper {
            width: fit-content;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .header-area {
            text-align: center;
            margin-bottom: 15px;
        }

        .header-title {
            font-size: 34px;
            font-weight: 900;
            margin: 0 0 6px 0;
            line-height: 1.15;
        }

        .header-subtitle {
            font-size: 24px;
            color: #000000;
            font-weight: 800;
            margin: 0 0 12px 0;
            line-height: 1.2;
        }

        /* "סה"כ X נשים" summary badge, under the subtitle */
        .total-badge {
            background-color: #8A42FF;
            color: #ffffff;
            font-size: 24px;
            font-weight: 800;
            padding: 4px 22px;
            border-radius: 4px;
            display: inline-block;
            margin: 0 auto;
            line-height: 1.25;
        }

        .chart-body {
            display: grid;
            grid-template-columns: {{ name_col_width }}px {{ bar_col_width }}px;
            row-gap: 8px;
            column-gap: 8px;
            align-items: center;
            margin-top: 20px;
        }

        .party-name {
            font-size: 20px;
            font-weight: 800;
            color: #000000;
            text-align: right;
            white-space: nowrap;
            line-height: 1;
        }

        .bar-area {
            display: flex;
            align-items: center;
            direction: ltr;
            height: 36px;
        }

        .bar-container {
            display: flex;
            align-items: center;
            height: 36px;
            flex-shrink: 0;
        }

        .bar-women {
            background-color: #8A42FF;
            color: #ffffff;
            font-weight: 800;
            font-size: 20px;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            padding-left: 10px;
            box-sizing: border-box;
        }

        .bar-women.narrow {
            justify-content: center;
            padding-left: 0;
            font-size: 16px;
        }

        .bar-men {
            background-color: #B5B4C4;
            height: 100%;
        }

        .total-mandates {
            font-weight: 800;
            font-size: 20px;
            color: #000000;
            margin-left: 10px;
            line-height: 1;
        }

        /* 5050 logo, floating below the whole chart */
        .logo-container {
            display: flex;
            justify-content: center;
            width: 100%;
            margin-top: -20px;
            z-index: 10;
        }

        .logo-floating {
            width: {{ logo_size }}px;
            height: auto;
            object-fit: contain;
        }
    </style>
</head>
<body>

    <div class="chart-wrapper">
        <div class="header-area">
            <h1 class="header-title">{{ title_line1 }}</h1>
            <p class="header-subtitle">{{ title_line2 }}</p>
            <div class="total-badge">סה"כ {{ total_women }} נשים</div>
        </div>

        <div class="chart-body">
            {% for row in rows %}
            <div class="party-name">{{ row.party }}</div>
            <div class="bar-area">
                <div class="bar-container" style="width: {{ row.total_px }}px;">
                    {% if row.women > 0 %}
                    <div class="bar-women{% if row.narrow %} narrow{% endif %}" style="width: {{ row.women_px }}px;">{{ row.women }}</div>
                    {% endif %}
                    {% if row.men > 0 %}
                    <div class="bar-men" style="width: {{ row.men_px }}px;"></div>
                    {% endif %}
                </div>
                <span class="total-mandates">{{ row.total }}</span>
            </div>
            {% endfor %}
        </div>

        {% if logo_data_uri %}
        <div class="logo-container">
            <img class="logo-floating" src="{{ logo_data_uri }}" alt="5050 לוגו">
        </div>
        {% endif %}
    </div>

</body>
</html>

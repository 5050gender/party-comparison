<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <style>
        /* Heebo embedded locally as data: URIs -- no network/CDN dependency
           at render time (matches the arc chart's font). */
        @font-face {
            font-family: 'Heebo';
            src: url('{{ heebo_regular_data_uri }}') format('truetype');
            font-weight: 400;
        }
        @font-face {
            font-family: 'Heebo';
            src: url('{{ heebo_bold_data_uri }}') format('truetype');
            font-weight: 700;
        }
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }
        body {
            font-family: 'Heebo', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #ffffff;
            color: #000000;
            display: flex;
            justify-content: center;
            padding: 14px 10px 18px;
        }

        .chart-wrapper {
            width: fit-content;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
        }

        .header-area {
            text-align: center;
            margin-bottom: 15px;
        }

        .header-title {
            font-size: 34px;
            font-weight: 900;
            margin: 0;
            line-height: 1.15;
        }

        .header-subtitle {
            font-size: 24px;
            color: #000000;
            font-weight: 800;
            margin: 0;
            line-height: 1.2;
        }

        /* Row pairing the outlet's logo with the title+subtitle text block
           (only used when outlet_name is set). The logo is the row's first
           element, so in this RTL layout it lands on the right-hand side,
           right next to the text -- and align-items: center on the row
           vertically centers the logo against the whole text block, so its
           middle sits between the title and subtitle lines rather than
           beside just one of them. Sized to match the 5050 logo (see
           outlet_logo_size / .logo-floating below). */
        .header-text-row {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 15px;
            margin: 0 0 12px 0;
        }

        .header-text-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
        }

        .outlet-logo {
            width: {{ outlet_logo_size }}px;
            height: auto;
            object-fit: contain;
        }

        /* "סה"כ X נשים" summary badge, under the subtitle */
        .total-badge {
            background-color: #8A42FF;
            color: #ffffff;
            font-size: 34px;
            font-weight: 800;
            padding: 4px 22px;
            border-radius: 4px;
            display: inline-block;
            margin: 0 auto;
            line-height: 1.25;
        }

        .chart-body {
            display: grid;
            direction: ltr;
            grid-template-columns: {{ name_col_width }}px {{ bar_col_width }}px;
            row-gap: 8px;
            column-gap: 8px;
            align-items: center;
            margin-top: 20px;
        }

        .party-name {
            font-size: 22px;
            font-weight: 400;
            color: #000000;
            direction: rtl;
            text-align: right;
            white-space: nowrap;
            line-height: 1;
        }

        .bar-area {
            display: flex;
            align-items: center;
            direction: ltr;
            height: 36px;
        }

        .bar-container {
            display: flex;
            align-items: center;
            height: 36px;
            flex-shrink: 0;
        }

        .bar-women {
            background-color: #8A42FF;
            color: #ffffff;
            font-weight: 800;
            font-size: 20px;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding-right: 10px;
            box-sizing: border-box;
        }

        .bar-women.narrow {
            justify-content: center;
            padding-right: 0;
        }

        .bar-women.narrow-font {
            font-size: 16px;
        }

        .bar-men {
            background-color: #f7d398;
            height: 100%;
        }

        .total-mandates {
            font-weight: 800;
            font-size: 20px;
            color: #000000;
            margin-left: 10px;
            line-height: 1;
        }

        /* 5050 logo, floating over the bottom-right corner of the chart */
        .logo-container {
            position: absolute;
            bottom: 70px;
            right: 20px;
            z-index: 10;
        }

        .logo-floating {
            width: {{ logo_size }}px;
            height: auto;
            object-fit: contain;
        }
    </style>
</head>
<body>

    <div class="chart-wrapper">
        <div class="header-area">
            <div class="header-text-row">
                {% if outlet_logo_data_uri %}<img class="outlet-logo" src="{{ outlet_logo_data_uri }}" alt="{{ outlet_name }}">{% endif %}
                <div class="header-text-col">
                    <h1 class="header-title">{{ title_line1 }}</h1>
                    {% if outlet_name %}
                    <p class="header-subtitle">לפי סקר {{ outlet_name }} | תאריך: {{ poll_date_str }}</p>
                    {% else %}
                    <p class="header-subtitle">{{ title_line2 }}</p>
                    {% endif %}
                </div>
            </div>
            <div class="total-badge">סה"כ {{ total_women }} נשים</div>
        </div>

        <div class="chart-body">
            {% for row in rows %}
            <div class="party-name">{{ row.party }}</div>
            <div class="bar-area">
                <div class="bar-container" style="width: {{ row.total_px }}px;">
                    {% if row.women > 0 %}
                    <div class="bar-women{% if row.narrow %} narrow{% endif %}{% if row.narrow_font %} narrow-font{% endif %}" style="width: {{ row.women_px }}px;">{{ row.women }}</div>
                    {% endif %}
                    {% if row.men > 0 %}
                    <div class="bar-men" style="width: {{ row.men_px }}px;"></div>
                    {% endif %}
                </div>
                <span class="total-mandates">{{ row.total }}</span>
            </div>
            {% endfor %}
        </div>

        {% if logo_data_uri %}
        <div class="logo-container">
            <img class="logo-floating" src="{{ logo_data_uri }}" alt="5050 לוגו">
        </div>
        {% endif %}
    </div>

</body>
</html>

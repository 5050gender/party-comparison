<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <style>
        /* Heebo embedded locally as data: URIs -- no network/CDN dependency
           at render time (matches the matplotlib charts' bundled font). */
        @font-face {
            font-family: 'Heebo';
            src: url('{{ heebo_regular_data_uri }}') format('truetype');
            font-weight: 400;
        }
        @font-face {
            font-family: 'Heebo';
            src: url('{{ heebo_bold_data_uri }}') format('truetype');
            font-weight: 700;
        }
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }
        body {
            font-family: 'Heebo', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
            background-color: #ffffff;
            color: #000000;
            display: flex;
            justify-content: center;
            padding: 12px 14px 14px;
        }

        .chart-wrapper {
            width: 400px;
            display: flex;
            flex-direction: column;
        }

        .header-area {
            text-align: center;
            margin-bottom: 10px;
        }

        .header-title {
            font-size: 21px;
            font-weight: 900;
            margin: 0 0 3px 0;
            letter-spacing: -0.4px;
            line-height: 1.15;
        }

        .header-subtitle {
            font-size: 12px;
            color: #333;
            font-weight: 500;
            margin: 0;
            line-height: 1.25;
        }

        .chart-body {
            position: relative;
            display: flex;
            flex-direction: column;
            gap: 5.5px;
        }

        /* Overlaid in the blank space of the zero-seat rows (party name
           and "0" label both sit at the left, so the right side of those
           rows is empty). `top`/`width`/`height` are computed in Python
           from the actual rendered layout (see render_bar_chart_html) so
           the logo always sits clear of both the real bars above it and
           the legend below it, regardless of how many zero-seat rows
           exist. */
        .chart-wrapper {
            position: relative;
        }
        .logo-overlay {
            position: absolute;
            right: 8px;
            object-fit: contain;
            pointer-events: none;
            z-index: 5;
        }

        /* Fallback when the dataset has no zero-seat rows to overlay onto:
           a plain footer watermark below the legend, which never overlaps
           real bars. */
        .logo-footer {
            display: flex;
            justify-content: center;
            margin-top: 10px;
        }
        .logo-footer img {
            width: 70px;
            height: 70px;
            object-fit: contain;
        }

        .party-item {
            display: flex;
            flex-direction: column;
        }

        .party-name {
            font-size: 11.5px;
            font-weight: 700;
            color: #111;
            text-align: left;
            direction: rtl;
            margin-bottom: 1.5px;
            padding-left: 2px;
            line-height: 1.1;
        }

        .bar-row {
            display: flex;
            align-items: center;
            height: 17px;
            direction: ltr;
        }

        .bar-container {
            flex-grow: 1;
            display: flex;
            align-items: center;
            height: 100%;
        }

        .bar-women {
            background-color: #702283;
            color: #ffffff;
            font-weight: bold;
            font-size: 11px;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 2.5px 0 0 2.5px;
        }

        .bar-men {
            background-color: #bdbdbd;
            height: 100%;
            border-radius: 0 2.5px 2.5px 0;
        }

        .bar-men.full {
            border-radius: 2.5px;
        }

        .total-label {
            font-weight: 900;
            font-size: 12.5px;
            color: #000000;
            margin-left: 6px;
            line-height: 1;
        }

        .zero-label {
            font-weight: 900;
            font-size: 12.5px;
            color: #000000;
            margin-left: 2px;
            line-height: 1;
        }

        .legend {
            display: flex;
            justify-content: center;
            gap: 16px;
            margin-top: 12px;
            direction: rtl;
            font-size: 11.5px;
            font-weight: 600;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .legend-color {
            width: 16px;
            height: 10px;
            border-radius: 2px;
        }

        .legend-color.women { background-color: #702283; }
        .legend-color.men { background-color: #bdbdbd; }
    </style>
</head>
<body>

    <div class="chart-wrapper">
        <div class="header-area">
            <h1 class="header-title">{{ title_line1 }}</h1>
            <p class="header-subtitle">{{ title_line2 }}</p>
        </div>

        <div class="chart-body">
            {% for row in rows %}
            <div class="party-item"{% if row.total == 0 %} data-zero="true"{% endif %}>
                <div class="party-name">{{ row.party }}</div>
                <div class="bar-row">
                    <div class="bar-container">
                        {% if row.total > 0 %}
                        {% if row.women > 0 %}
                        <div class="bar-women" style="width: {{ row.women_pct }}%;">{{ row.women }}</div>
                        {% endif %}
                        <div class="bar-men{% if row.women == 0 %} full{% endif %}" style="width: {{ row.men_pct }}%;"></div>
                        <div class="total-label">{{ row.total }}</div>
                        {% else %}
                        <span class="zero-label">0</span>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>

        <div class="legend">
            <div class="legend-item">
                <div class="legend-color women"></div>
                <span>כמות נשים צפויה</span>
            </div>
            <div class="legend-item">
                <div class="legend-color men"></div>
                <span>כמות גברים צפויה</span>
            </div>
        </div>

        {% if logo_data_uri and logo_top is not none %}
        <img class="logo-overlay" src="{{ logo_data_uri }}" alt="5050 לוגו"
             style="top: {{ logo_top }}px; width: {{ logo_size }}px; height: {{ logo_size }}px;">
        {% elif logo_footer_uri %}
        <div class="logo-footer">
            <img src="{{ logo_footer_uri }}" alt="5050 לוגו">
        </div>
        {% endif %}
    </div>

</body>
</html>

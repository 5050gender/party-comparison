{#
  Bloc bar chart (per bloc_bar_chart_preview_v2) -- the alternative to
  arc_chart.html.j2, picked with --bloc-chart-style bars|both.

  Header / font / logo variables are the same as arc_chart.html.j2:
    heebo_regular_data_uri, heebo_bold_data_uri,
    title_line1, title_line2, outlet_name, outlet_logo_data_uri, outlet_logo_width,
    poll_date_str, logo_data_uri, logo_width, logo_height

  Everything else is precomputed by build_bloc_bar_chart_data() in
  plot_women_by_outlet.py:
    chart_width, total_women,
    main_rows    -- one big bar per bloc (שינוי on top, then ימין+חרדים):
                    {label, seats, women, men, width_px, women_color, men_color, count_word}
    small_groups -- the reservists + unmapped parties (e.g. המשותפת), drawn
                    as small bars side by side under the bloc rows:
                    {label, seats, women, men, width_px, women_color, men_color, count_word}
    legend       -- {name, women_color, men_color}
#}
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8">
<style>
  @font-face {
    font-family: 'Heebo';
    src: url('{{ heebo_regular_data_uri }}') format('truetype');
    font-weight: 400;
  }
  @font-face {
    font-family: 'Heebo';
    src: url('{{ heebo_bold_data_uri }}') format('truetype');
    font-weight: 700;
  }
  body {
    margin: 0;
    background: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    font-family: 'Heebo', sans-serif;
    color: #000;
  }
  .chart-wrapper {
    width: {{ chart_width }}px;
    box-sizing: border-box;
    padding: 32px;
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .header-text-row { display: flex; align-items: center; gap: 20px; }
  .header-text-col { display: flex; flex-direction: column; gap: 6px; }
  .header-title { font-size: 34px; font-weight: 700; margin: 0; line-height: 1.1; }
  .header-subtitle { font-size: 21px; font-weight: 700; margin: 0; line-height: 1.2; }
  .outlet-logo { width: {{ outlet_logo_width }}px; height: auto; object-fit: contain; flex: none; }

  .total { font-size: 26px; font-weight: 700; }

  .rows {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 12px; row-gap: 22px;
    align-items: start;
  }
  .row { display: contents; }
  .row-name {
    display: flex; flex-direction: column; justify-content: center;
    align-items: flex-start;
    height: 44px;
  }
  .row-label { font-size: 28px; font-weight: 700; line-height: 1.2; }
  .row-seats { font-size: 16px; }
  .row-body { display: flex; flex-direction: column; gap: 6px; }
  .bar { height: 44px; display: flex; gap: 3px; }
  .part { display: flex; }
  .count { font-size: 17px; padding-right: 8px; }
  .women-seg { display: flex; align-items: center; padding-right: 8px; min-width: 0; }
  .women-seg b { color: #fff; font-size: 26px; font-weight: 700; line-height: 1; }
  .count b { font-size: 24px; font-weight: 700; }

  .small-groups { display: flex; align-items: flex-start; gap: 48px; }
  .small-group { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; }
  .small-group .bar { gap: 0; margin-bottom: 6px; }
  .small-label { font-size: 15px; font-weight: 700; line-height: 1.2; }
  .small-seats { font-size: 14px; }
  .small-count { font-size: 15px; }
  .small-count b { font-size: 19px; font-weight: 700; }

  .footer { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .legend { display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; font-size: 15px; }
  .legend-item { display: flex; align-items: center; gap: 5px; }
  .sw { width: 12px; height: 12px; display: inline-block; }
  .legend-note { color: #444; }
  .logo { width: {{ logo_width }}px; height: {{ logo_height }}px; object-fit: contain; flex: none; }
</style>
</head>
<body>

<div class="chart-wrapper" id="chart">
  {% if title_line1 or title_line2 or outlet_name %}
  <div class="header-text-row">
    {% if outlet_logo_data_uri %}<img class="outlet-logo" src="{{ outlet_logo_data_uri }}" alt="{{ outlet_name }}">{% endif %}
    <div class="header-text-col">
      {% if title_line1 %}<h1 class="header-title">{{ title_line1 }}</h1>{% endif %}
      {% if outlet_name %}
      <p class="header-subtitle">לפי סקר {{ outlet_name }} | תאריך: {{ poll_date_str }}</p>
      {% elif title_line2 %}
      <p class="header-subtitle">{{ title_line2 }}</p>
      {% endif %}
    </div>
  </div>
  {% endif %}

  <div class="total">סה"כ {{ total_women }} חברות כנסת</div>

  <div class="rows">
    {% for row in main_rows %}
    <div class="row">
      <div class="row-name">
        <span class="row-label">{{ row.label }}</span>
        <span class="row-seats">{{ row.seats }} מושבים</span>
      </div>
      <div class="row-body">
        <div class="bar" style="width: {{ '%.1f' | format(row.width_px) }}px;">
          <div class="part" style="flex: {{ row.seats }} 1 0px;">
            {% if row.women > 0 %}<div class="women-seg" style="flex: {{ row.women }} 1 0px; background: {{ row.women_color }};"><b>{{ row.women }}</b></div>{% endif %}
            {% if row.men > 0 %}<div style="flex: {{ row.men }} 1 0px; background: {{ row.men_color }};"></div>{% endif %}
          </div>
        </div>
        <div class="count">{{ row.count_word }}</div>
      </div>
    </div>
    {% endfor %}

    {% if small_groups %}
    <div class="row">
      <div></div>
      <div class="row-body">
        <div class="small-groups">
          {% for g in small_groups %}
          <div class="small-group">
            <div class="bar" style="width: {{ '%.1f' | format(g.width_px) }}px;">
              {% if g.women > 0 %}<div style="flex: {{ g.women }} 1 0px; background: {{ g.women_color }};"></div>{% endif %}
              {% if g.men > 0 %}<div style="flex: {{ g.men }} 1 0px; background: {{ g.men_color }};"></div>{% endif %}
            </div>
            <span class="small-label">{{ g.label }}</span>
            <span class="small-seats">{{ g.seats }} מושבים</span>
            <div class="small-count">
              <b style="color: {{ g.women_color }};">{{ g.women }}</b>
              {{ g.count_word }}
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}
  </div>

  <div class="footer">
    <div class="legend">
      {% for item in legend %}
      <div class="legend-item">
        <span class="sw" style="background: {{ item.women_color }};"></span>
        <span class="sw" style="background: {{ item.men_color }};"></span>
        <span>{{ item.name }}</span>
      </div>
      {% endfor %}
      <span class="legend-note">כהה = נשים · בהיר = גברים</span>
    </div>
    {% if logo_data_uri %}<img class="logo" src="{{ logo_data_uri }}" alt="5050">{% endif %}
  </div>
</div>

</body>
</html>
